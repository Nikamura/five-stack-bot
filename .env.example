# Required: Telegram bot token from @BotFather
BOT_TOKEN=

# Path to SQLite file. In Docker, mount a volume here.
DB_PATH=./data/five-stack.db

# Default timezone for new chats (IANA name).
DEFAULT_TZ=Europe/Vilnius

# Log level: debug | info | warn | error
LOG_LEVEL=info

# HTTPS origin registered as the Main Mini App URL in BotFather.
MINI_APP_URL=https://five-stack-bot.cn.lt
# Leave empty for the Main Mini App; set only when using a named Mini App.
MINI_APP_SHORT_NAME=

# HTTP listener behind Caddy. Docker sets WEB_HOST=0.0.0.0.
WEB_HOST=127.0.0.1
WEB_PORT=3000
